    "why": {
      "type": "pawlet-gift",
      "settings": {
        "background_color": "#24203f",
        "image": "shopify://shop_images/giftlist-why.jpg",
        "image_position": "left",
        "eyebrow": "Why Gift List Co",
        "heading": "Gift-giving, solved",
        "text": "<p>We pick gifts that are useful, well made and fairly priced, then sort them by who they’re for. Find the right one in minutes, not hours.</p>",
        "point_1": "Gifts sorted by recipient, so you skip the endless scrolling",
        "point_2": "Free US shipping on every order, from US warehouses",
        "point_3": "30-day returns if it’s not quite right",
        "button_label": "Shop all gifts",
        "button_link": "shopify://collections/gifts",
        "sticker_icon": "gift"
      }
    },
    "faq": {
      "type": "pawlet-faq",
      "blocks": {
        "q_shipping": {
          "type": "question",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>Orders ship from US warehouses and usually arrive in 4–8 business days. Shipping is free on every US order, and you’ll get tracking by email.</p>"
          }
        },
        "q_gift": {
          "type": "question",
          "settings": {
            "question": "Can I send a gift straight to them?",
            "answer": "<p>Yes. At checkout, enter their name and address as the shipping address and we’ll deliver it to their door.</p>"
          }
        },
        "q_returns": {
          "type": "question",
          "settings": {
            "question": "What if they don’t love it?",
            "answer": "<p>Return unused items within 30 days of delivery. If something arrives damaged, send us a photo and we’ll replace it or refund you.</p>"
          }
        },
        "q_pay": {
          "type": "question",
          "settings": {
            "question": "How do I pay?",
            "answer": "<p>We accept PayPal. Your payment is processed securely by PayPal, and we never see your card details.</p>"
          }
        },
        "q_spanish": {
          "type": "question",
          "settings": {
            "question": "¿Hablan español?",
            "answer": "<p>¡Sí! Escríbenos en español cuando quieras.</p>"
          }
        }
      },
      "block_order": [
        "q_shipping",
        "q_gift",
        "q_returns",
        "q_pay",
        "q_spanish"
      ],
