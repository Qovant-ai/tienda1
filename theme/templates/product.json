                "border_width": 1,
                "border_opacity": 100,
                "border_radius": 16,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "product_title": {
              "type": "product-title",
              "name": "t:names.product_title",
              "settings": {
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "paragraph",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 4,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "price": {
              "type": "price",
              "name": "t:names.product_price",
              "settings": {
                "show_sale_price_first": true,
                "show_installments": false,
                "show_tax_info": false,
                "type_preset": "h6",
                "width": "100%",
                "alignment": "left",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            }
          },
          "block_order": [
            "product-card-gallery",
            "product_title",
            "price"
          ]
        }
      },
      "block_order": [
        "header"
      ],
      "type": "product-recommendations"
    },
    "trust": {
      "type": "pawlet-trust",
      "blocks": {
        "trust_shipping": {
          "type": "item",
          "settings": {
            "icon": "truck",
            "title": "Free shipping over $30",
            "text": "Fast delivery from US warehouses"
          }
        },
        "trust_returns": {
          "type": "item",
          "settings": {
            "icon": "refresh",
            "title": "30-day happiness guarantee",
            "text": "Easy returns, no fuss"
          }
        },
        "trust_checkout": {
          "type": "item",
          "settings": {
            "icon": "lock",
            "title": "Secure checkout",
            "text": "Pay safely with PayPal"
          }
        },
        "trust_help": {
          "type": "item",
          "settings": {
            "icon": "chat",
