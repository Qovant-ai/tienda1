                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {
                "quantity": {
                  "type": "quantity",
                  "static": true,
                  "settings": {
                    "input_style": "custom",
                    "input_background_color": "{{ settings.color_palette.background }}",
                    "input_text_color": "{{ settings.color_palette.color10 }}",
                    "input_border_color": "{{ settings.color_palette.color11 }}"
                  },
                  "blocks": {}
                },
                "add-to-cart": {
                  "type": "add-to-cart",
                  "static": true,
                  "settings": {
                    "style_class": "button-custom",
                    "custom_button_background": "{{ settings.color_palette.color10 }}",
                    "custom_button_text": "{{ settings.color_palette.background }}",
                    "custom_button_border": "{{ settings.color_palette.color10 }}"
                  },
                  "blocks": {}
                },
                "accelerated-checkout": {
                  "type": "accelerated-checkout",
                  "static": true,
                  "settings": {},
                  "blocks": {}
                }
              },
              "block_order": []
            },
            "perks": {
              "type": "pawlet-product-perks",
              "settings": {
                "free_shipping_threshold": 30,
                "shipping_text": "Free shipping over $30",
                "shipping_free_text": "Free US shipping",
                "origin_text": "Ships from the US",
                "guarantee_text": "30-day returns",
                "checkout_text": "Secure PayPal checkout"
              },
              "blocks": {}
            },
            "text_aEtTtq": {
              "type": "text",
              "name": "Description",
              "settings": {
                "text": "{{ closest.product.description }}",
                "width": "100%",
                "max_width": "none",
                "alignment": "left",
                "type_preset": "rte",
                "font": "var(--font-primary--family)",
                "font_size": "",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "info": {
              "type": "pawlet-product-accordion",
              "settings": {
                "icon_1": "truck",
                "title_1": "Shipping & delivery",
                "content_1": "<p>Free shipping on orders of $30 or more; $5.99 below that. Ships from a US warehouse within 1–3 business days and usually arrives 3–7 business days later, with tracking by email.</p><p><a href=\"/pages/shipping-policy\" title=\"Shipping Policy\">Shipping policy</a></p>",
                "icon_2": "refresh",
                "title_2": "Returns & happiness guarantee",
                "content_2": "<p>Not the right fit? Return unused items in their original packaging within 30 days of delivery. Arrived damaged? Send us a photo and we'll replace it or refund you.</p><p><a href=\"/pages/return-policy\" title=\"Refund Policy\">Refund policy</a></p>",
                "icon_3": "chat",
                "title_3": "Questions?",
                "content_3": "<p>We're happy to help in English or Spanish. Check our <a href=\"/pages/faqs\" title=\"FAQ\">FAQ</a> or <a href=\"/pages/contact\" title=\"Contact\">send us a message</a>.</p>"
              },
              "blocks": {}
            }
          },
          "block_order": [
            "group_icgrde",
            "variant_picker_R3rGDr",
            "buy_buttons_eYQEYi",
            "perks",
            "text_aEtTtq",
            "info"
          ]
        }
      },
      "settings": {
        "content_width": "content-center-aligned",
        "desktop_media_position": "left",
        "equal_columns": false,
        "limit_details_width": false,
        "gap": 48,
        "enable_sticky_add_to_cart": true,
        "background_color": "{{ settings.color_palette.color8 }}",
        "padding-block-start": 48,
        "padding-block-end": 48
      }
    },
    "recommendations": {
      "settings": {
        "product": "{{ closest.product }}",
        "recommendation_type": "related",
        "layout_type": "grid",
        "carousel_on_mobile": false,
        "max_products": 4,
        "columns": 4,
        "mobile_columns": "2",
        "columns_gap": 12,
        "rows_gap": 24,
        "icons_style": "arrow",
        "icons_shape": "none",
        "section_width": "page-width",
        "gap": 28,
        "padding-block-start": 64,
        "padding-block-end": 64,
        "background_color": "#fff3ea"
      },
      "blocks": {
        "header": {
          "type": "text",
          "name": "t:names.header",
          "settings": {
            "text": "<h3>You may also like</h3>",
            "type_preset": "h3"
          }
        },
        "static-product-card": {
          "type": "_product-card",
          "name": "t:names.product_card",
          "static": true,
          "settings": {
            "product_card_gap": 4
