    "faq": {
      "type": "pawlet-faq",
      "blocks": {
        "q_shipping": {
          "type": "question",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>Orders ship from US warehouses within 1–3 business days and usually arrive 3–7 business days later. Shipping is free on orders of $30 or more ($5.99 below that), and you'll get tracking by email.</p>"
          }
        },
        "q_returns": {
          "type": "question",
          "settings": {
            "question": "What if my pet doesn't like it?",
            "answer": "<p>Return unused items within 30 days of delivery. If something arrives damaged, send us a photo and we'll replace it or refund you.</p>"
          }
        },
        "q_pay": {
          "type": "question",
          "settings": {
            "question": "How do I pay?",
            "answer": "<p>We accept PayPal. Your payment is processed securely by PayPal, and we never see your card details.</p>"
          }
        },
        "q_club": {
          "type": "question",
          "settings": {
            "question": "When does the monthly Club launch?",
            "answer": "<p>Club Dog ($39.99/month) and Club Cat ($32.99/month) launch in January 2027. Join the waitlist above and we'll email you on launch day.</p>"
          }
        },
        "q_spanish": {
          "type": "question",
          "settings": {
            "question": "¿Hablan español?",
            "answer": "<p>¡Sí! Cambia el idioma de la tienda a español y escríbenos en español cuando quieras.</p>"
          }
        }
