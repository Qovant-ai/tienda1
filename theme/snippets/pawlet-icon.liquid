{% doc %}
  Renders a Pawlet Club brand icon as inline SVG. Stroke icons use currentColor;
  the paw icons are filled.

  @param {string} icon - Icon name: paw, paws, box, heart, truck, pause, ball, bone, brush, gift, check, arrow, star, chat, sparkle, shield, lock, refresh, pin, tag
  @param {string} [class] - Extra CSS class for the svg element

  @example
  {% render 'pawlet-icon', icon: 'box', class: 'pc-icon' %}
{% enddoc %}
{%- liquid
  assign svg_class = 'pc-svg'
  if class != blank
    assign svg_class = svg_class | append: ' ' | append: class
  endif
-%}
{%- case icon -%}
  {%- when 'paw' -%}
    <svg class="{{ svg_class }}" viewBox="15 21 90 90" aria-hidden="true" focusable="false" fill="currentColor"><ellipse cx="30" cy="55" rx="9" ry="11.5" transform="rotate(-20 30 55)"/><ellipse cx="47" cy="39" rx="9.5" ry="12" transform="rotate(-6 47 39)"/><ellipse cx="73" cy="39" rx="9.5" ry="12" transform="rotate(6 73 39)"/><ellipse cx="90" cy="55" rx="9" ry="11.5" transform="rotate(20 90 55)"/><path d="M60 62 C 74 62, 88 76, 88 90 C 88 101, 79 106, 70 104 C 66 103, 63 101, 60 101 C 57 101, 54 103, 50 104 C 41 106, 32 101, 32 90 C 32 76, 46 62, 60 62 Z"/></svg>
  {%- when 'paws' -%}
    <svg class="{{ svg_class }}" viewBox="0 0 120 120" aria-hidden="true" focusable="false"><g transform="translate(-11 7.3) scale(0.95) rotate(-12 60 66)" fill="var(--pc-paw-big, currentColor)"><ellipse cx="30" cy="55" rx="9" ry="11.5" transform="rotate(-20 30 55)"/><ellipse cx="47" cy="39" rx="9.5" ry="12" transform="rotate(-6 47 39)"/><ellipse cx="73" cy="39" rx="9.5" ry="12" transform="rotate(6 73 39)"/><ellipse cx="90" cy="55" rx="9" ry="11.5" transform="rotate(20 90 55)"/><path d="M60 62 C 74 62, 88 76, 88 90 C 88 101, 79 106, 70 104 C 66 103, 63 101, 60 101 C 57 101, 54 103, 50 104 C 41 106, 32 101, 32 90 C 32 76, 46 62, 60 62 Z"/></g><g transform="translate(69.6 0.96) scale(0.44) rotate(18 60 66)" fill="var(--pc-paw-small, currentColor)"><ellipse cx="30" cy="55" rx="9" ry="11.5" transform="rotate(-20 30 55)"/><ellipse cx="47" cy="39" rx="9.5" ry="12" transform="rotate(-6 47 39)"/><ellipse cx="73" cy="39" rx="9.5" ry="12" transform="rotate(6 73 39)"/><ellipse cx="90" cy="55" rx="9" ry="11.5" transform="rotate(20 90 55)"/><path d="M60 62 C 74 62, 88 76, 88 90 C 88 101, 79 106, 70 104 C 66 103, 63 101, 60 101 C 57 101, 54 103, 50 104 C 41 106, 32 101, 32 90 C 32 76, 46 62, 60 62 Z"/></g></svg>
  {%- when 'box' -%}
    <svg class="{{ svg_class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5 12 4l9 4.5v7L12 20l-9-4.5z"/><path d="m3 8.5 9 4.5 9-4.5M12 13v7"/></svg>
  {%- when 'heart' -%}
    <svg class="{{ svg_class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.4-9-9.2C1.7 7.6 3.8 4.5 7 4.5c2 0 3.4 1.1 5 3 1.6-1.9 3-3 5-3 3.2 0 5.3 3.1 4 6.3-2 4.8-9 9.2-9 9.2z"/></svg>
  {%- when 'truck' -%}
    <svg class="{{ svg_class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 6h11v10H2zM13 9h4.5l3.5 3.5V16h-8z"/><circle cx="6" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
  {%- when 'pause' -%}
    <svg class="{{ svg_class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M10 9v6M14 9v6"/></svg>
  {%- when 'ball' -%}
    <svg class="{{ svg_class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M5.5 5.8c3.4 2.6 3.4 9.8 0 12.4M18.5 5.8c-3.4 2.6-3.4 9.8 0 12.4"/></svg>
  {%- when 'bone' -%}
    <svg class="{{ svg_class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 15.5 15.5 8.5M7 13.6a2.5 2.5 0 1 0-2.3 3.6 2.5 2.5 0 1 0 3.6 2.3zM17 10.4a2.5 2.5 0 1 0 2.3-3.6 2.5 2.5 0 1 0-3.6-2.3z"/></svg>
  {%- when 'brush' -%}
    <svg class="{{ svg_class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20 13 11M13 11l2-2 6 6-2 2zM15 9l4-4"/><path d="M16 12l1 1M18 10l1 1"/></svg>
  {%- when 'gift' -%}
    <svg class="{{ svg_class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11h16v9H4zM3 7h18v4H3zM12 7v13"/><path d="M12 7c-1.5-3-5-3.5-5-1.2C7 7 9 7 12 7zM12 7c1.5-3 5-3.5 5-1.2C17 7 15 7 12 7z"/></svg>
  {%- when 'check' -%}
    <svg class="{{ svg_class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
  {%- when 'arrow' -%}
    <svg class="{{ svg_class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
  {%- when 'star' -%}
    <svg class="{{ svg_class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3.5 2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"/></svg>
  {%- when 'chat' -%}
    <svg class="{{ svg_class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16v11H9l-5 4z"/><path d="M8.5 10.5h.01M12 10.5h.01M15.5 10.5h.01"/></svg>
  {%- when 'sparkle' -%}
    <svg class="{{ svg_class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c.6 4.6 2.4 6.4 7 7-4.6.6-6.4 2.4-7 7-.6-4.6-2.4-6.4-7-7 4.6-.6 6.4-2.4 7-7zM19 16c.2 1.6.9 2.3 2.5 2.5-1.6.2-2.3.9-2.5 2.5-.2-1.6-.9-2.3-2.5-2.5 1.6-.2 2.3-.9 2.5-2.5z"/></svg>
  {%- when 'shield' -%}
    <svg class="{{ svg_class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.4 7.5 9.5 4.3-1.1 7.5-4.9 7.5-9.5V6z"/><path d="m8.8 12.2 2.3 2.3 4.3-4.6"/></svg>
  {%- when 'lock' -%}
    <svg class="{{ svg_class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4.5" y="10.5" width="15" height="10" rx="2"/><path d="M8 10.5V7.8a4 4 0 0 1 8 0v2.7M12 14.5v2.5"/></svg>
  {%- when 'refresh' -%}
    <svg class="{{ svg_class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 11a8 8 0 0 0-14.3-4.9L4 8"/><path d="M4 3.5V8h4.5M4 13a8 8 0 0 0 14.3 4.9L20 16"/><path d="M20 20.5V16h-4.5"/></svg>
  {%- when 'pin' -%}
    <svg class="{{ svg_class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.3"/></svg>
  {%- when 'tag' -%}
    <svg class="{{ svg_class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 12.2V4.5a1 1 0 0 1 1-1h7.7l8.3 8.3a1.5 1.5 0 0 1 0 2.1l-6.6 6.6a1.5 1.5 0 0 1-2.1 0z"/><circle cx="8" cy="8" r="1.4"/></svg>
{%- endcase -%}
