{% comment %}
  Section contract.
  Pawlet Club category cards. Large cards show a photo with the title on top; small
  cards show the photo above the title and product count. Each card links to a
  collection and uses its image unless a custom image is picked.
  @example
  <!-- Theme editor: add "Pawlet categories" and pick a collection per card -->
{% endcomment %}
{% render 'pawlet-styles' %}
{%- liquid
  assign s = section.settings
-%}
<section
  class="pc-section pc-cats"
  style="--pc-cats-bg: {{ s.background_color }};"
  {% if s.heading != blank %}
    aria-labelledby="PcCatsTitle-{{ section.id }}"
  {% endif %}
>
  <div class="pc-container">
    {% if s.eyebrow != blank or s.heading != blank or s.text != blank %}
      <div class="pc-head">
        {% if s.eyebrow != blank %}
          <p class="pc-eyebrow">{% render 'pawlet-icon', icon: 'paw' %}{{ s.eyebrow | escape }}</p>
        {% endif %}
        {% if s.heading != blank %}
          <h2 id="PcCatsTitle-{{ section.id }}" class="pc-title">{{ s.heading | escape }}</h2>
        {% endif %}
        {% if s.text != blank %}
          <div class="pc-lead">{{ s.text }}</div>
        {% endif %}
      </div>
    {% endif %}

    <ul class="pc-cats__grid" role="list">
      {% for block in section.blocks %}
        {%- liquid
          assign b = block.settings
          assign cat = b.collection
          assign cat_title = b.title
          if cat_title == blank and cat != blank
            assign cat_title = cat.title
          endif
          assign cat_url = b.link
          if cat_url == blank and cat != blank
            assign cat_url = cat.url
          endif
          assign cat_image = b.image
          if cat_image == blank and cat != blank
            assign cat_image = cat.featured_image
          endif
          if b.size == 'large'
            assign image_sizes = '(min-width: 990px) 36rem, 92vw'
          else
            assign image_sizes = '(min-width: 990px) 18rem, 46vw'
          endif
        -%}
        <li class="pc-cat pc-cat--{{ b.size }}{% if cat_image == blank %} pc-cat--solid{% endif %}" {{ block.shopify_attributes }}>
          <a class="pc-cat__link" href="{{ cat_url | default: routes.all_products_collection_url }}">
            <span class="pc-cat__media">
              {% if cat_image != blank %}
                {{
                  cat_image
                  | image_url: width: 1200
                  | image_tag:
                    widths: '360, 540, 720, 960, 1200',
                    sizes: image_sizes,
                    loading: 'lazy',
                    class: 'pc-cat__img',
                    alt: ''
                }}
              {% else %}
                <span class="pc-cat__icon">{% render 'pawlet-icon', icon: 'paws' %}</span>
              {% endif %}
            </span>
            <span class="pc-cat__body">
              <span class="pc-cat__title">{{ cat_title | escape }}</span>
              {% if b.text != blank %}
                <span class="pc-cat__text">{{ b.text | escape }}</span>
              {% elsif cat != blank and cat.products_count > 0 %}
                <span class="pc-cat__text">
                  {{- cat.products_count }}
                  {% if cat.products_count == 1 %}{{ s.product_label_one | escape }}{% else %}{{ s.product_label_other | escape }}{% endif -%}
                </span>
              {% endif %}
              {% if b.button_label != blank %}
                <span class="pc-cat__cta">
                  {{- b.button_label | escape }}
                  {% render 'pawlet-icon', icon: 'arrow' -%}
                </span>
              {% else %}
                <span class="pc-cat__arrow">{% render 'pawlet-icon', icon: 'arrow' %}</span>
              {% endif %}
            </span>
          </a>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

{% stylesheet %}
  .pc-cats {
    background: var(--pc-cats-bg, #ffffff);
  }

  .pc-cats__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.875rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pc-cat {
    min-width: 0;
  }

  .pc-cat--large {
    grid-column: span 2;
  }

  .pc-cat__link {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: 1.5rem;
    background: var(--pc-cream);
    color: var(--pc-navy);
    text-decoration: none;
    transition: transform 0.25s var(--ease-out-cubic), box-shadow 0.25s ease;
  }

  .pc-cat__link:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 36px rgb(27 43 72 / 0.14);
  }

  .pc-cat__link:focus-visible {
    outline: 3px solid var(--pc-peach);
    outline-offset: 3px;
  }

  .pc-cat__media {
    position: relative;
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    background: #ffffff;
  }

  .pc-cat__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out-cubic);
  }

  .pc-cat__link:hover .pc-cat__img {
    transform: scale(1.05);
  }

  .pc-cat__body {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
    padding: 1rem 1.125rem 1.125rem;
  }

  .pc-cat__title {
    flex: 1 1 100%;
    font-family: var(--font-heading--family);
    font-size: 1.125rem;
    font-weight: var(--font-heading--weight);
    line-height: 1.2;
  }

  .pc-cat__text {
    flex: 1 1 auto;
    font-size: 0.875rem;
    color: var(--pc-ink-soft);
  }

  .pc-cat__arrow {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin-inline-start: auto;
    border-radius: 50%;
    background: var(--pc-navy);
    color: #ffffff;
  }

  .pc-cat__arrow .pc-svg {
    width: 1rem;
    height: 1rem;
    transition: transform 0.2s var(--ease-out-cubic);
  }

  .pc-cat__link:hover .pc-cat__arrow .pc-svg {
    transform: translateX(2px);
  }

  /* Large cards: photo fills the card, copy sits on a gradient. */
  .pc-cat--large .pc-cat__media {
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
  }

  .pc-cat--large .pc-cat__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(27 43 72 / 0.82) 0%, rgb(27 43 72 / 0.25) 45%, rgb(27 43 72 / 0) 70%);
  }

  .pc-cat--large .pc-cat__link {
    justify-content: flex-end;
    min-height: clamp(18rem, 42vw, 26rem);
    color: #ffffff;
  }

  .pc-cat--large .pc-cat__body {
    position: relative;
    z-index: 1;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .pc-cat--large .pc-cat__title {
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    letter-spacing: -0.02em;
  }

  .pc-cat--large .pc-cat__text {
    flex-basis: 100%;
    font-size: 1rem;
    color: rgb(255 255 255 / 0.9);
  }

  .pc-cat__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-block-start: 0.75rem;
    padding: 0.75rem 1.25rem;
    border-radius: 999px;
    background: var(--pc-peach);
    color: var(--pc-navy);
    font-family: var(--font-accent--family);
    font-weight: 500;
    line-height: 1;
  }

  .pc-cat__cta .pc-svg {
    width: 1rem;
    height: 1rem;
  }

  /* Solid cards: no photo, brand color with the paws mark. */
  .pc-cat--solid .pc-cat__link {
    --pc-paw-big: var(--pc-peach);
    --pc-paw-small: #ffffff;

    background: var(--pc-navy);
    color: #ffffff;
  }

  .pc-cat--solid .pc-cat__media {
    display: grid;
    place-items: center;
    background: transparent;
  }

  .pc-cat--solid .pc-cat__icon {
    display: block;
    width: 45%;
  }

  .pc-cat--solid .pc-cat__text {
    color: rgb(255 255 255 / 0.8);
  }

  .pc-cat--solid .pc-cat__arrow {
    background: var(--pc-peach);
    color: var(--pc-navy);
  }

  .pc-cat--solid.pc-cat--large .pc-cat__media::after {
    content: none;
  }

  @media screen and (min-width: 990px) {
    .pc-cats__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 1.25rem;
    }

    .pc-cat--large {
      grid-column: span 6;
    }

    .pc-cat--small {
      grid-column: span 3;
    }

    .pc-cat__title {
      font-size: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pc-cat__link,
    .pc-cat__img,
    .pc-cat__arrow .pc-svg {
      transition: none;
    }

    .pc-cat__link:hover,
    .pc-cat__link:hover .pc-cat__img {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Pawlet categories",
  "tag": "div",
  "class": "pc-shopify-section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop by pet"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find what they'll love"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "product_label_one",
      "label": "Product count label (one)",
      "default": "product"
    },
    {
      "type": "text",
      "id": "product_label_other",
      "label": "Product count label (many)",
      "default": "products"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Leave empty to use the collection title."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "info": "Leave empty to show the number of products."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Leave empty to use the collection image."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Leave empty to link to the collection."
        },
        {
          "type": "select",
          "id": "size",
          "label": "Card size",
          "options": [
            { "value": "large", "label": "Large (2 per row)" },
            { "value": "small", "label": "Small (4 per row)" }
          ],
          "default": "small"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "info": "Shown on large cards. Leave empty to show an arrow."
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Pawlet categories",
      "blocks": [
        { "type": "category", "settings": { "size": "large", "title": "Dogs", "button_label": "Shop dogs" } },
        { "type": "category", "settings": { "size": "large", "title": "Cats", "button_label": "Shop cats" } },
        { "type": "category", "settings": { "size": "small" } },
        { "type": "category", "settings": { "size": "small" } },
        { "type": "category", "settings": { "size": "small" } },
        { "type": "category", "settings": { "size": "small" } }
      ]
    }
  ]
}
{% endschema %}
