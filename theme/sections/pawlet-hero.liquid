{% comment %}
  Section contract.
  Pawlet Club home hero: headline with highlighted words, intro, two calls to action,
  trust checks and an arched photo with a price badge and paw-print decoration.
  @example
  <!-- Theme editor: add "Pawlet hero", pick a photo and set the button links -->
{% endcomment %}
{% render 'pawlet-styles' %}
{%- liquid
  assign s = section.settings
-%}
<section
  class="pc-section pc-hero"
  style="--pc-hero-bg: {{ s.background_color }};"
  aria-labelledby="PcHeroTitle-{{ section.id }}"
>
  {% render 'pawlet-icon', icon: 'paw', class: 'pc-paw-deco pc-hero__deco pc-hero__deco--one' %}
  {% render 'pawlet-icon', icon: 'paw', class: 'pc-paw-deco pc-hero__deco pc-hero__deco--two' %}

  <div class="pc-container pc-hero__grid">
    <div class="pc-hero__copy">
      {% if s.eyebrow != blank %}
        <p class="pc-eyebrow">{% render 'pawlet-icon', icon: 'paw' %}{{ s.eyebrow | escape }}</p>
      {% endif %}

      <h1 id="PcHeroTitle-{{ section.id }}" class="pc-title pc-hero__title">
        {{ s.heading | escape }}
        {% if s.heading_highlight != blank %}
          <span class="pc-hero__highlight">{{ s.heading_highlight | escape }}</span>
        {% endif %}
      </h1>

      {% if s.text != blank %}
        <div class="pc-lead pc-hero__text">{{ s.text }}</div>
      {% endif %}

      <div class="pc-actions">
        {% if s.button_1_label != blank and s.button_1_link != blank %}
          <a class="pc-btn pc-btn--primary" href="{{ s.button_1_link }}">
            {{ s.button_1_label | escape }}
            {% render 'pawlet-icon', icon: 'arrow' %}
          </a>
        {% endif %}
        {% if s.button_2_label != blank and s.button_2_link != blank %}
          <a class="pc-btn pc-btn--outline" href="{{ s.button_2_link }}">{{ s.button_2_label | escape }}</a>
        {% endif %}
      </div>

      {%- capture checks -%}
        {%- for i in (1..3) -%}
          {%- assign check_key = 'check_' | append: i -%}
          {%- assign check = s[check_key] -%}
          {%- if check != blank -%}
            <li>
              <span class="pc-hero__check-icon">{% render 'pawlet-icon', icon: 'check' %}</span>
              {{ check | escape }}
            </li>
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {% if checks != blank %}
        <ul class="pc-hero__checks" role="list">
          {{ checks }}
        </ul>
      {% endif %}
    </div>

    <div class="pc-hero__media">
      <div class="pc-hero__frame">
        {% if s.image != blank %}
          {{
            s.image
            | image_url: width: 1400
            | image_tag:
              widths: '480, 720, 960, 1200, 1400',
              sizes: '(min-width: 990px) 34rem, (min-width: 750px) 60vw, 92vw',
              loading: 'eager',
              fetchpriority: 'high',
              class: 'pc-hero__img'
          }}
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'pc-hero__img pc-hero__placeholder' }}
        {% endif %}
      </div>

      {% if s.badge_price != blank %}
        <p class="pc-hero__badge">
          {% if s.badge_top != blank %}<span>{{ s.badge_top | escape }}</span>{% endif %}
          <strong>{{ s.badge_price | escape }}</strong>
          {% if s.badge_bottom != blank %}<span>{{ s.badge_bottom | escape }}</span>{% endif %}
        </p>
      {% endif %}

      <div class="pc-hero__paws">{% render 'pawlet-icon', icon: 'paws' %}</div>
    </div>
  </div>
</section>

{% stylesheet %}
  .pc-hero {
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3.5rem, 8vw, 6.5rem);
    background: var(--pc-hero-bg, var(--pc-cream));
  }

  .pc-hero__grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4.5rem);
    align-items: center;
  }

  .pc-hero__copy {
    position: relative;
    z-index: 1;
    min-width: 0;
  }

  .pc-hero__title {
    font-size: clamp(2.5rem, 6.2vw, 4.5rem);
    line-height: 1.02;
  }

  .pc-hero__highlight {
    position: relative;
    z-index: 0;
    display: inline-block;
    white-space: nowrap;
  }

  .pc-hero__highlight::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset-inline: -0.06em;
    inset-block-end: 0.04em;
    height: 0.34em;
    border-radius: 999px;
    background: var(--pc-peach);
  }

  .pc-hero__text {
    margin-block-end: 2rem;
  }

  .pc-hero__checks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .pc-hero__checks li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .pc-hero__check-icon {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--pc-navy);
    color: #ffffff;
  }

  .pc-hero__check-icon .pc-svg {
    width: 0.875rem;
    height: 0.875rem;
  }

  .pc-hero__media {
    position: relative;
    justify-self: center;
    width: min(100%, 32rem);
  }

  .pc-hero__media::before {
    content: '';
    position: absolute;
    z-index: 0;
    inset-inline-end: -6%;
    inset-block-end: -5%;
    width: 72%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--pc-peach);
  }

  .pc-hero__frame {
    position: relative;
    z-index: 1;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 16rem 16rem 2rem 2rem;
    background: var(--pc-peach-soft);
    box-shadow: 0 30px 60px rgb(27 43 72 / 0.18);
  }

  .pc-hero__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pc-hero__placeholder {
    fill: var(--pc-ink-soft);
    opacity: 0.4;
  }

  .pc-hero__badge {
    position: absolute;
    z-index: 2;
    inset-inline-start: -0.75rem;
    inset-block-end: 10%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 8.5rem;
    height: 8.5rem;
    margin: 0;
    border-radius: 50%;
    background: var(--pc-navy);
    color: #ffffff;
    text-align: center;
    line-height: 1.2;
    transform: rotate(-8deg);
    box-shadow: 0 14px 30px rgb(27 43 72 / 0.3);
  }

  .pc-hero__badge span {
    font-size: 0.8125rem;
  }

  .pc-hero__badge strong {
    margin-block: 0.125rem;
    font-family: var(--font-heading--family);
    font-size: 1.75rem;
    font-weight: var(--font-heading--weight);
    line-height: 1;
  }

  .pc-hero__paws {
    --pc-paw-big: var(--pc-navy);
    --pc-paw-small: var(--pc-peach);

    position: absolute;
    z-index: 2;
    inset-block-start: -1.75rem;
    inset-inline-end: -0.5rem;
    width: 6.5rem;
    transform: rotate(10deg);
  }

  .pc-hero__deco {
    opacity: 0.16;
  }

  .pc-hero__deco--one {
    inset-block-start: 6%;
    inset-inline-start: -2.5rem;
    width: 8rem;
    transform: rotate(-24deg);
  }

  .pc-hero__deco--two {
    inset-block-end: 5%;
    inset-inline-start: 44%;
    width: 4.5rem;
    transform: rotate(18deg);
  }

  @media screen and (min-width: 990px) {
    .pc-hero__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    }

    .pc-hero__badge {
      inset-inline-start: -2.5rem;
    }
  }

  @media screen and (max-width: 749px) {
    .pc-hero__badge {
      width: 7rem;
      height: 7rem;
      inset-inline-start: 0;
    }

    .pc-hero__badge strong {
      font-size: 1.375rem;
    }

    .pc-hero__paws {
      width: 5rem;
      inset-inline-end: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Pawlet hero",
  "tag": "div",
  "class": "pc-shopify-section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#fff3ea"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Monthly boxes for dogs & cats"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A happy box for your best friend,"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Highlighted words",
      "info": "Shown after the heading with a peach underline.",
      "default": "every month."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Toys, treats and care picked for your pet's size, age and play style, delivered to your door.</p>"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "First button label",
      "default": "Start Club Dog"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "First button link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Second button label",
      "default": "Start Club Cat"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Second button link"
    },
    {
      "type": "header",
      "content": "Highlights"
    },
    {
      "type": "text",
      "id": "check_1",
      "label": "Highlight 1",
      "default": "Free US shipping"
    },
    {
      "type": "text",
      "id": "check_2",
      "label": "Highlight 2",
      "default": "Skip or cancel anytime"
    },
    {
      "type": "text",
      "id": "check_3",
      "label": "Highlight 3",
      "default": "Hablamos español"
    },
    {
      "type": "header",
      "content": "Photo"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "badge_top",
      "label": "Badge top line",
      "default": "From"
    },
    {
      "type": "text",
      "id": "badge_price",
      "label": "Badge price",
      "default": "$32.99"
    },
    {
      "type": "text",
      "id": "badge_bottom",
      "label": "Badge bottom line",
      "default": "per month"
    }
  ],
  "presets": [
    {
      "name": "Pawlet hero"
    }
  ]
}
{% endschema %}
