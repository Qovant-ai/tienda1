{% comment %}
  Section contract.
  "What's inside every box" for Pawlet Club: one card per item type (toys, treats, care,
  surprise) with a count, an icon and a description, plus an optional theme note.
  @example
  <!-- Theme editor: add "Pawlet box contents" and edit the item blocks -->
{% endcomment %}
{% render 'pawlet-styles' %}
{%- liquid
  assign s = section.settings
  assign columns = section.blocks.size
  if columns > 4
    assign columns = 4
  elsif columns < 1
    assign columns = 1
  endif
-%}
<section
  class="pc-section pc-inside"
  style="--pc-inside-bg: {{ s.background_color }}; --pc-inside-columns: {{ columns }};"
  {% if s.heading != blank %}
    aria-labelledby="PcInsideTitle-{{ section.id }}"
  {% endif %}
>
  <div class="pc-container">
    {% if s.eyebrow != blank or s.heading != blank or s.text != blank %}
      <div class="pc-head">
        {% if s.eyebrow != blank %}
          <p class="pc-eyebrow">{% render 'pawlet-icon', icon: 'box' %}{{ s.eyebrow | escape }}</p>
        {% endif %}
        {% if s.heading != blank %}
          <h2 id="PcInsideTitle-{{ section.id }}" class="pc-title">{{ s.heading | escape }}</h2>
        {% endif %}
        {% if s.text != blank %}
          <div class="pc-lead">{{ s.text }}</div>
        {% endif %}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <ul class="pc-inside__grid" role="list">
        {% for block in section.blocks %}
          <li class="pc-inside__card" {{ block.shopify_attributes }}>
            <div class="pc-inside__top">
              <span class="pc-inside__icon">{% render 'pawlet-icon', icon: block.settings.icon %}</span>
              {% if block.settings.count != blank %}
                <span class="pc-inside__count">{{ block.settings.count | escape }}</span>
              {% endif %}
            </div>
            {% if block.settings.title != blank %}
              <h3 class="pc-inside__title">{{ block.settings.title | escape }}</h3>
            {% endif %}
            {% if block.settings.text != blank %}
              <p class="pc-inside__text">{{ block.settings.text | escape }}</p>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}

    {% if s.theme_note != blank %}
      <div class="pc-inside__note">
        <span class="pc-inside__note-icon">{% render 'pawlet-icon', icon: 'sparkle' %}</span>
        <div>{{ s.theme_note }}</div>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .pc-inside {
    background: var(--pc-inside-bg, #ffffff);
  }

  .pc-inside__grid {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pc-inside__card {
    min-width: 0;
    padding: 1.75rem 1.5rem;
    border: 1px solid var(--pc-line);
    border-radius: 1.5rem;
    background: #ffffff;
    transition: transform 0.2s var(--ease-out-cubic), box-shadow 0.2s ease;
  }

  .pc-inside__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 32px rgb(27 43 72 / 0.08);
  }

  .pc-inside__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-block-end: 1.25rem;
  }

  .pc-inside__icon {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--pc-peach-soft);
    color: var(--pc-navy);
  }

  .pc-inside__icon .pc-svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .pc-inside__count {
    font-family: var(--font-heading--family);
    font-size: 2.25rem;
    font-weight: var(--font-heading--weight);
    line-height: 1;
    color: var(--pc-navy);
  }

  .pc-inside__title {
    margin: 0 0 0.5rem;
    font-family: var(--font-heading--family);
    font-size: 1.25rem;
    font-weight: var(--font-heading--weight);
    line-height: 1.25;
    color: var(--pc-navy);
  }

  .pc-inside__text {
    margin: 0;
    line-height: 1.55;
    color: var(--pc-ink-soft);
  }

  .pc-inside__note {
    display: flex;
    align-items: center;
    gap: 1rem;
    max-width: 48rem;
    margin: 2.5rem auto 0;
    padding: 1.25rem 1.5rem;
    border-radius: 1.25rem;
    background: var(--pc-cream);
    line-height: 1.55;
  }

  .pc-inside__note p {
    margin: 0;
  }

  .pc-inside__note-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--pc-peach);
    color: var(--pc-navy);
  }

  .pc-inside__note-icon .pc-svg {
    width: 1.375rem;
    height: 1.375rem;
  }

  @media screen and (min-width: 750px) {
    .pc-inside__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    .pc-inside__grid {
      grid-template-columns: repeat(var(--pc-inside-columns, 4), minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pc-inside__card {
      transition: none;
    }

    .pc-inside__card:hover {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Pawlet box contents",
  "tag": "div",
  "class": "pc-shopify-section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Inside every box"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "5 to 6 goodies, every single month"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "richtext",
      "id": "theme_note",
      "label": "Theme note"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "ball", "label": "Ball" },
            { "value": "bone", "label": "Bone" },
            { "value": "brush", "label": "Brush" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "gift", "label": "Gift" },
            { "value": "heart", "label": "Heart" },
            { "value": "paw", "label": "Paw" },
            { "value": "box", "label": "Box" }
          ],
          "default": "ball"
        },
        {
          "type": "text",
          "id": "count",
          "label": "Count",
          "default": "2"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Item"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Pawlet box contents",
      "blocks": [
        { "type": "item", "settings": { "icon": "ball", "count": "2", "title": "Toys" } },
        { "type": "item", "settings": { "icon": "bone", "count": "2", "title": "Treats" } },
        { "type": "item", "settings": { "icon": "brush", "count": "1", "title": "Care item" } },
        { "type": "item", "settings": { "icon": "sparkle", "count": "1", "title": "Surprise" } }
      ]
    }
  ]
}
{% endschema %}
